{
  "name": "brennprozess-app",
  "version": "1.0.0",
  "description": "Brennprozess desktop app.",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "cli": "node mp4-search.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "postinstall": "echo \"Installation complete. Run npm start to launch the app.\""
  },
  "devDependencies": {
    "electron": "^26.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ch.fhnw.brennprozess",
    "productName": "Brennprozess",
    "files": [
      "brennprozess.html",
      "brennprozess.css",
      "brennprozess.js",
      "electron-main.js",
      "preload.js",
      "mp4-search.js",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  },
  "keywords": ["mp4", "search", "electron", "desktop"],
  "author": "",
  "license": "MIT"
}
